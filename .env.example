# Copy this file to .env before starting the environment:
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit it.
# The values below are for a local environment that is reachable only from
# your own machine. Do not reuse them anywhere else.

# Prefix for the names of the containers, networks and volumes that Docker
# Compose creates for the course.
COMPOSE_PROJECT_NAME=course

# Credentials for the local object storage (the S3-compatible service that
# holds the data lake). Every service that reads or writes data uses them.
S3_ACCESS_KEY_ID=course-local
S3_SECRET_ACCESS_KEY=course-local-secret

# Region name sent with S3 requests. Local object storage ignores the value,
# but S3 clients refuse to start without one.
S3_REGION=us-east-1
